<div class="inner-header">
  <div class="container"><div class="pull-left"><h6 class="inner-title">Sản phẩm</h6></div><div class="pull-right"><div class="beta-breadcrumb font-large"><a href="/">Trang chủ</a> / <span>Sản phẩm</span></div></div><div class="clearfix"></div></div>
</div>
<div class="container"><div id="content"><div class="main-content"><div class="space50">&nbsp;</div>
  <div class="beta-products-list"><h4>Tất cả sản phẩm</h4><div class="beta-products-details"><p class="pull-left"><%= products.length %> sản phẩm từ db_banhang</p><div class="clearfix"></div></div><div class="product-grid">
    <% products.forEach((product) => { %>
      <%- include('partials/product-card', { product, columns: 3 }) %>
    <% }); %>
  </div></div>
</div></div></div>

<div class="inner-header"><div class="container"><div class="pull-left"><h6 class="inner-title">Giỏ hàng</h6></div><div class="pull-right"><div class="beta-breadcrumb font-large"><a href="/">Trang chủ</a> / <span>Giỏ hàng</span></div></div><div class="clearfix"></div></div></div>
<div class="container"><div id="content"><div class="space50">&nbsp;</div>
  <div class="cart-account-bar"><span>Xin chào, <strong><%= user.fullName || user.email %></strong></span> <a href="/logout">Đăng xuất</a></div>
  <% if (!items.length) { %>
    <div class="beta-shopping-cart"><div class="text-center"><i class="fa fa-shopping-cart fa-3x"></i><h2>Giỏ hàng đang trống</h2><p>Hãy chọn sản phẩm yêu thích để thêm vào giỏ hàng.</p><a class="beta-btn primary" href="/product_type.html">Xem sản phẩm <i class="fa fa-chevron-right"></i></a></div></div>
  <% } else { %>
    <div class="table-responsive"><table class="shop_table beta-shopping-cart-table"><thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead><tbody>
      <% items.forEach((item) => { %><tr class="cart_item"><td class="product-name"><div class="media"><img class="pull-left" src="/images/product/<%= item.image %>" alt="<%= item.name %>" width="90"><div class="media-body"><p class="font-large table-title"><%= item.name %></p></div></div></td><td><span class="amount"><%= Number(item.price).toLocaleString('vi-VN') %>đ</span></td><td><form action="/cart/update" method="post"><input type="hidden" name="productId" value="<%= item.product_id %>"><input type="number" name="quantity" value="<%= item.quantity %>" min="1" max="99" class="cart-quantity"><button type="submit" class="btn btn-default">Cập nhật</button></form></td><td><span class="amount"><%= Number(item.subtotal).toLocaleString('vi-VN') %>đ</span></td><td><form action="/cart/remove" method="post"><input type="hidden" name="productId" value="<%= item.product_id %>"><button type="submit" class="remove" title="Xóa sản phẩm" aria-label="Xóa sản phẩm"><i class="fa fa-trash-o"></i></button></form></td></tr><% }); %>
    </tbody></table></div><div class="cart-total text-right"><strong>Tổng tiền: <%= Number(total).toLocaleString('vi-VN') %>đ</strong></div>
  <% } %>
  <div class="space60">&nbsp;</div>
</div></div>

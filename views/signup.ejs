<div class="inner-header">
  <div class="container"><div class="pull-left"><h6 class="inner-title">Đăng ký</h6></div><div class="pull-right"><div class="beta-breadcrumb font-large"><a href="/">Trang chủ</a> / <span>Đăng ký</span></div></div><div class="clearfix"></div></div>
</div>
<div class="container"><div id="content"><div class="space50">&nbsp;</div><div class="row"><div class="col-sm-3"></div><div class="col-sm-6">
  <form action="/signup.html" method="post" class="beta-form-checkout">
    <h4>Tạo tài khoản</h4>
    <% if (error) { %><p class="alert alert-danger"><%= error %></p><% } %>
    <div class="form-block"><label for="fullName">Họ và tên*</label><input type="text" id="fullName" name="fullName" required></div>
    <div class="form-block"><label for="email">Email*</label><input type="email" id="email" name="email" required></div>
    <div class="form-block"><label for="password">Mật khẩu*</label><input type="password" id="password" name="password" minlength="6" required></div>
    <div class="form-block"><button type="submit" class="btn btn-primary">Đăng ký <i class="fa fa-user-plus"></i></button></div>
  </form>
</div><div class="col-sm-3"></div></div><div class="space60">&nbsp;</div></div></div>
